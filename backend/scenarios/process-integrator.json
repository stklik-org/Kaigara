                  }
                ]
              }
            },
            {
              "id": "submodels-hold",
              "startSeconds": 120,
              "durationSeconds": 360,
              "shape": {
                "kind": "constant",
                "ratePerSec": 80
              },
              "requests": {
                "requests": [
                  {
                    "id": "query-submodel",
                    "operation": "query",
                    "target": "submodel",
                    "weight": 1,
                    "generator": {
                      "kind": "randomized",
                      "sizeBytes": 0
                    }
                  },
                  {
                    "id": "create-submodel",
                    "operation": "create",
                    "target": "submodel",
                    "weight": 1,
                    "generator": {
                      "kind": "randomized",
                      "sizeBytes": 65536
                    }
                  },
                  {
                    "id": "update-submodel",
                    "operation": "update",
                    "target": "submodel",
                    "weight": 1,
                    "generator": {
                      "kind": "mutate",
                      "baseValue": "{}",
                      "mutationRatePercent": 25
                    }
                  }
