                  {
                    "id": "update-submodel",
                    "operation": "update",
                    "target": "submodel",
                    "weight": 1.5,
                    "generator": {
                      "kind": "mutate",
                      "baseValue": "{}",
                      "mutationRatePercent": 25
                    }
                  }
                ]
              }
            }
          ]
        }
      ]
    },
    "postconditions": [
      {
        "id": "q1",
        "label": "schema: written-data",
        "kind": "schema-check",
        "config": {
          "against": "written-data"
        }
      }
    ],
    "cleanup": [
      {
        "id": "u1",
        "label": "delete-seeded",
        "kind": "cleanup-mode",
        "config": {
          "mode": "delete-seeded",
          "modificationLevel": "small"
        }
      }
    ]
