{
  "id": "process-integrator",
  "name": "Process integrator",
  "description": "StressForge's write-heavy profile — extra-large submodels, almost all traffic on submodel elements.",
  "phases": {
    "preparation": [
      {
        "id": "seed-shells",
        "label": "shells: 1000",
        "kind": "seed-shells",
        "config": {
          "count": 1000
        }
      },
      {
        "id": "seed-submodels",
        "label": "submodels: 3000",
        "kind": "seed-submodels",
        "config": {
          "count": 3000,
          "size": "extra-large"
        }
      },
      {
        "id": "seed-generator-nameplate",
        "label": "nameplate ×1",
        "kind": "seed-generator",
        "config": {
          "generator": "nameplate",
          "weight": 1,
          "size": "extra-large"
        }
      },
      {
        "id": "seed-generator-technical-data",
        "label": "technical-data ×1",
        "kind": "seed-generator",
        "config": {
          "generator": "technical-data",
          "weight": 1,
          "size": "extra-large"
        }
      },
      {
        "id": "seed-generator-handover-documentation",
        "label": "handover-documentation ×1",
        "kind": "seed-generator",
        "config": {
          "generator": "handover-documentation",
          "weight": 1,
          "size": "extra-large"
        }
      },
      {
        "id": "seed-generator-workplace-operations-queue",
        "label": "workplace-operations-queue ×10",
        "kind": "seed-generator",
        "config": {
          "generator": "workplace-operations-queue",
          "weight": 10,
          "size": "extra-large"
        }
      }
    ],
    "preconditions": [
      {
        "id": "c1",
        "label": "conformance: SSP-002",
        "kind": "conformance-check",
        "config": {
          "profile": "SSP-002"
        }
      }
    ],
    "method": {
      "totalDurationSeconds": 600,
      "tracks": [
        {
          "id": "shells",
          "label": "Shells",
          "color": "#2977d6",
          "loads": [
            {
              "id": "shells-ramp-up",
              "startSeconds": 0,
              "durationSeconds": 120,
              "shape": {
                "kind": "ramp",
                "direction": "up",
                "fromRatePerSec": 0,
                "toRatePerSec": 20
              },
              "requests": {
                "requests": [
                  {
                    "id": "query-shell",
                    "operation": "query",
                    "target": "shell",
                    "weight": 1,
                    "generator": {
                      "kind": "randomized",
                      "sizeBytes": 0
                    }
                  },
                  {
                    "id": "create-shell",
                    "operation": "create",
                    "target": "shell",
                    "weight": 2,
                    "generator": {
                      "kind": "randomized",
                      "sizeBytes": 65536
                    }
                  }
                ]
              }
            },
            {
              "id": "shells-hold",
              "startSeconds": 120,
              "durationSeconds": 360,
              "shape": {
                "kind": "constant",
                "ratePerSec": 20
              },
              "requests": {
                "requests": [
                  {
                    "id": "query-shell",
                    "operation": "query",
                    "target": "shell",
                    "weight": 1,
                    "generator": {
                      "kind": "randomized",
                      "sizeBytes": 0
                    }
                  },
                  {
                    "id": "create-shell",
                    "operation": "create",
                    "target": "shell",
                    "weight": 2,
                    "generator": {
                      "kind": "randomized",
                      "sizeBytes": 65536
                    }
                  }
                ]
              }
            },
            {
              "id": "shells-ramp-down",
              "startSeconds": 480,
              "durationSeconds": 120,
              "shape": {
                "kind": "ramp",
                "direction": "down",
                "fromRatePerSec": 20,
                "toRatePerSec": 0
              },
              "requests": {
                "requests": [
                  {
                    "id": "query-shell",
                    "operation": "query",
                    "target": "shell",
                    "weight": 1,
                    "generator": {
                      "kind": "randomized",
                      "sizeBytes": 0
                    }
                  },
                  {
                    "id": "create-shell",
                    "operation": "create",
                    "target": "shell",
                    "weight": 2,
                    "generator": {
                      "kind": "randomized",
                      "sizeBytes": 65536
                    }
                  }
                ]
              }
            }
          ]
        },
        {
