          "label": "Submodels",
          "color": "#eb6733",
          "loads": [
            {
              "id": "submodels-ramp-up",
              "startSeconds": 0,
              "durationSeconds": 120,
              "shape": {
                "kind": "ramp",
                "direction": "up",
                "fromRatePerSec": 0,
                "toRatePerSec": 80
              },
              "requests": {
                "requests": [
                  {
                    "id": "query-submodel",
                    "operation": "query",
                    "target": "submodel",
                    "weight": 1,
                    "generator": {
                      "kind": "randomized",
                      "sizeBytes": 0
