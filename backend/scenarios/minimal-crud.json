{
  "id": "minimal-crud",
  "name": "Minimal lifecycle (create, read, delete)",
  "description": "Create an AAS and a submodel, read them back, then delete them — one step every 10 seconds. There is no update step: every update card in the request catalogue is currently add-disabled.",
  "phases": {
    "preparation": [],
    "preconditions": [],
    "method": {
      "totalDurationSeconds": 30,
      "tracks": [
        {
          "id": "lifecycle",
          "label": "AAS lifecycle",
          "color": "#2977d6",
          "loads": [
            {
              "id": "create",
              "startSeconds": 0,
              "durationSeconds": 0,
              "shape": { "kind": "individual", "requestCount": 2 },
              "requests": {
                "requests": [
                  {
                    "id": "create-shell",
                    "operation": "create",
                    "target": "shell",
                    "weight": 1,
                    "generator": { "kind": "randomized", "sizeBytes": 512 },
                    "templateId": "create-aas",
                    "bindings": {
                      "aasId": {
                        "strategy": "sequence",
                        "config": { "format": "AAS-crud-<Num>" }
                      },
                      "payload": {
                        "strategy": "size-target",
                        "config": { "bytes": 512, "grow": "more elements" }
                      }
                    },
                    "mintId": { "format": "AAS-crud-<Num>" }
                  },
                  {
                    "id": "create-submodel",
                    "operation": "create",
                    "target": "submodel",
                    "weight": 1,
                    "generator": { "kind": "randomized", "sizeBytes": 512 },
                    "templateId": "create-submodel",
                    "bindings": {
                      "smId": {
                        "strategy": "sequence",
                        "config": { "format": "SM-crud-<Num>" }
                      },
                      "payload": {
                        "strategy": "size-target",
                        "config": { "bytes": 512, "grow": "more elements" }
                      }
                    },
                    "mintId": { "format": "SM-crud-<Num>" }
                  }
                ]
              }
            },
            {
              "id": "read",
              "startSeconds": 10,
              "durationSeconds": 0,
              "shape": { "kind": "individual", "requestCount": 2 },
              "requests": {
                "requests": [
                  {
                    "id": "read-shell",
                    "operation": "read",
                    "target": "shell",
                    "weight": 1,
                    "generator": { "kind": "randomized", "sizeBytes": 256 },
                    "templateId": "read-aas",
                    "bindings": {
                      "aasId": {
                        "strategy": "created-in-scenario",
                        "config": {}
                      }
                    }
                  },
                  {
                    "id": "read-submodel",
                    "operation": "read",
                    "target": "submodel",
                    "weight": 1,
                    "generator": { "kind": "randomized", "sizeBytes": 256 },
                    "templateId": "read-submodel",
                    "bindings": {
                      "smId": {
                        "strategy": "created-in-scenario",
                        "config": {}
                      }
                    }
                  }
                ]
              }
            },
            {
              "id": "delete",
              "startSeconds": 20,
              "durationSeconds": 0,
              "shape": { "kind": "individual", "requestCount": 2 },
              "requests": {
                "requests": [
                  {
                    "id": "delete-submodel",
                    "operation": "delete",
                    "target": "submodel",
                    "weight": 1,
                    "generator": { "kind": "randomized", "sizeBytes": 256 },
                    "templateId": "delete-submodel",
                    "bindings": {
                      "smId": {
                        "strategy": "created-in-scenario",
                        "config": {}
                      }
                    }
                  },
                  {
                    "id": "delete-shell",
                    "operation": "delete",
                    "target": "shell",
                    "weight": 1,
                    "generator": { "kind": "randomized", "sizeBytes": 256 },
                    "templateId": "delete-aas",
                    "bindings": {
                      "aasId": {
                        "strategy": "created-in-scenario",
                        "config": {}
                      }
                    }
                  }
                ]
              }
            }
          ]
        }
      ]
    },
    "postconditions": [],
    "cleanup": []
  }
}
