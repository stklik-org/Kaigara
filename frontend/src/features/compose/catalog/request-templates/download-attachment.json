{
  "id": "download-attachment",
  "title": "Download attachment",
  "operation": "read",
  "target": "submodel",
  "execution": "authoring",
  "summary": "GET file bytes back from a File element.",
  "endpoint": {
    "method": "GET",
    "path": "/submodels/{smId}/submodel-elements/{path}/attachment",
    "expect": [
      200
    ]
  },
  "parameters": [
    {
      "id": "smId",
      "label": "Submodel identifier",
      "type": "submodel-identifier",
      "bindsTo": "path.smId"
    },
    {
      "id": "path",
      "label": "File element",
      "type": "idshort-path",
      "bindsTo": "path.path"
    }
  ],
  "defaults": {
    "weight": 4
  },
  "kind": "request"
}
