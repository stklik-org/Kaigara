{
  "id": "replace-aas",
  "title": "Replace AAS",
  "operation": "update",
  "target": "aas",
  "execution": "engine",
  "summary": "PUT a whole shell over an existing one.",
  "endpoint": {
    "method": "PUT",
    "path": "/shells/{aasId}",
    "expect": [
      204,
      200
    ],
    "body": true
  },
  "parameters": [
    {
      "id": "aasId",
      "label": "AAS identifier",
      "type": "aas-identifier",
      "bindsTo": "path.aasId"
    },
    {
      "id": "payload",
      "label": "Replacement payload",
      "type": "payload-template",
      "bindsTo": "body",
      "strategies": [
        "minimal",
        "size-target",
        "custom-json"
      ],
      "default": "minimal"
    }
  ],
  "defaults": {
    "weight": 8
  },
  "kind": "request"
}
