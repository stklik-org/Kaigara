{
  "id": "create-aas",
  "title": "Create AAS",
  "operation": "create",
  "target": "aas",
  "execution": "engine",
  "summary": "POST one Asset Administration Shell.",
  "endpoint": {
    "method": "POST",
    "path": "/shells",
    "expect": [
      201
    ],
    "body": true
  },
  "parameters": [
    {
      "id": "aasId",
      "label": "New identifier",
      "type": "aas-identifier",
      "bindsTo": "body.id",
      "strategies": [
        "sequence",
        "existing"
      ],
      "default": "sequence"
    },
    {
      "id": "payload",
      "label": "Shell payload",
      "type": "payload-template",
      "bindsTo": "body",
      "strategies": [
        "minimal",
        "size-target"
      ],
      "default": "minimal"
    }
  ],
  "captures": {
    "aasId": "$.id"
  },
  "kind": "request"
}
