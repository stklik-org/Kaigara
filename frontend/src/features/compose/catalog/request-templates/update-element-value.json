{
  "id": "update-element-value",
  "title": "Update element value",
  "operation": "update",
  "target": "submodel",
  "execution": "authoring",
  "addDisabled": true,
  "addDisabledReason": "PATCH is authoring-only — the engine has no partial-update call yet.",
  "summary": "PATCH a single property — the smallest write the API offers.",
  "endpoint": {
    "method": "PATCH",
    "path": "/submodels/{smId}/submodel-elements/{path}/$value",
    "expect": [
      204,
      200
    ],
    "body": true
  },
  "parameters": [
    {
      "id": "smId",
      "label": "Submodel identifier",
      "type": "submodel-identifier",
      "bindsTo": "path.smId"
    },
    {
      "id": "path",
      "label": "Element to update",
      "type": "idshort-path",
      "bindsTo": "path.path",
      "default": "from-template"
    },
    {
      "id": "value",
      "label": "New value",
      "type": "value",
      "bindsTo": "body",
      "default": "random-number"
    }
  ],
  "kind": "request"
}
