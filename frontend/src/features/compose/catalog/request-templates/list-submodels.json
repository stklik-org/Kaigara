      200
    ],
    "query": {
      "limit": "{pageSize}"
    }
  },
  "parameters": [
    {
      "id": "pageSize",
      "label": "Page size",
      "type": "page-size",
      "bindsTo": "query.limit"
    }
  ],
  "kind": "request"
}
