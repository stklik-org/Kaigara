{
  "id": "list-submodels",
  "title": "List submodels (paged)",
  "operation": "query",
  "target": "submodel",
  "execution": "engine",
  "summary": "GET the submodel collection with limit/cursor paging.",
  "endpoint": {
    "method": "GET",
    "path": "/submodels",
